# Uploaded files live below this folder. Nothing here may ever run as a script.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|phps|cgi|shtml)(\.|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
